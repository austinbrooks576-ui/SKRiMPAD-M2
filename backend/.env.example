# ============================================================================
# SKRiMPAD commerce backend — configuration
# Copy to `.env` and fill in the real values from YOUR accounts. Nothing here
# is committed; the app reads these at runtime. This file documents every knob.
# ============================================================================

# --- server ---
PORT=8787
# Public base URL of THIS backend (used to build webhook + return URLs).
PUBLIC_URL=https://habitflow.ink/api/scrimpad
# Where the storefront lives — buyers return here after checkout.
SITE_URL=https://scrimpad.ink
# Comma-separated origins allowed to call this API (CORS).
ALLOWED_ORIGINS=https://scrimpad.ink,https://www.scrimpad.ink

# --- license signing ---
# 32+ random bytes, hex. Generate: `openssl rand -hex 32`
LICENSE_SIGNING_SECRET=replace-with-openssl-rand-hex-32

# --- Stripe ---   (dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Price IDs you create in Stripe (one per paid edition). $3 / $6 / $9.
STRIPE_PRICE_CONSUMER=price_xxx
STRIPE_PRICE_VGA=price_xxx
STRIPE_PRICE_SE=price_xxx

# --- PayPal ---   (developer.paypal.com/dashboard/applications)
PAYPAL_ENV=live                 # 'live' or 'sandbox'
PAYPAL_CLIENT_ID=xxx
PAYPAL_CLIENT_SECRET=xxx
PAYPAL_WEBHOOK_ID=xxx

# --- Google Play ---  (Play Console → Monetization → in-app products)
# Service-account JSON path for verifying Play purchases + RTDN.
GOOGLE_PLAY_SA_JSON=./play-service-account.json
GOOGLE_PLAY_PACKAGE=com.firstriff.skrimpadm2

# --- download artifacts (release asset URLs served after a valid license) ---
DL_CONSUMER_APK=https://github.com/austinbrooks576-ui/SKRiMPAD-M2/releases/latest/download/consumer.apk
DL_CONSUMER_WIN=https://github.com/austinbrooks576-ui/SKRiMPAD-M2/releases/latest/download/consumer-setup.exe
DL_VGA_APK=https://github.com/austinbrooks576-ui/SKRiMPAD-M2/releases/latest/download/vga.apk
DL_VGA_WIN=https://github.com/austinbrooks576-ui/SKRiMPAD-M2/releases/latest/download/vga-setup.exe
DL_SE_APK=https://github.com/austinbrooks576-ui/SKRiMPAD-M2/releases/latest/download/se.apk
DL_SE_WIN=https://github.com/austinbrooks576-ui/SKRiMPAD-M2/releases/latest/download/se-setup.exe
DL_LIVE_URL=https://scrimpad.ink/app
