{
  "name": "skrimpad-livex",
  "version": "1.0.0",
  "description": "SKRiMPAD LIVEx — plug in any controller, it draws itself and you play live",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/austinbrooks576-ui/SKRiMPAD-M2.git"
  },
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64 --publish never"
  },
  "build": {
    "appId": "com.firstriff.livex",
    "productName": "SKRiMPAD LIVEx",
    "publish": [
      { "provider": "github", "owner": "austinbrooks576-ui", "repo": "SKRiMPAD-M2" }
    ],
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "app/index.html",
        "to": "index.html"
      },
      {
        "from": "app/layout.json",
        "to": "layout.json"
      }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0"
  }
}
